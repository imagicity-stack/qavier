# ──────────────────────────────────────────────────────────────
#  QAVIER — Environment configuration
# ──────────────────────────────────────────────────────────────
#  Copy this file to `.env.local` and fill in your Shopify values.
#  Until these are set, the site runs on built-in demo data so you
#  can develop and preview the full experience with zero backend.
# ──────────────────────────────────────────────────────────────

# Your Shopify store domain, e.g. qavier.myshopify.com
SHOPIFY_STORE_DOMAIN=

# Storefront API public access token (Headless / Storefront API channel)
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Storefront API version (bump as Shopify releases new versions)
SHOPIFY_API_VERSION=2024-07

# Optional: collection handles that power each universe's landing rails.
# Defaults are used if left blank.
NEXT_PUBLIC_LUXE_COLLECTION=qavier-luxe
NEXT_PUBLIC_POPS_COLLECTION=qavier-pops

# Public site URL (used for metadata / Open Graph). Set on Vercel automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ──────────────────────────────────────────────────────────────
#  The four worlds (landing hub at /)
# ──────────────────────────────────────────────────────────────
#  The home page is a 2×2 hub: Qavier, Luxe, Pops, Essentials.
#  Qavier (the flagship store at /qavier) is ALWAYS open — no flag.
#  The other three default to a "coming soon" holding page; flip one
#  live by setting its var to `live` and redeploying. Any other value
#  (including unset) keeps it "coming soon".
#
#    live         → open that world
#    coming-soon  → holding page (default)

NEXT_PUBLIC_LUXE_STORE=coming-soon
NEXT_PUBLIC_POPS_STORE=coming-soon
NEXT_PUBLIC_ESSENTIALS_STORE=coming-soon

# Optional legacy switch to hold the whole flagship store behind a
# coming-soon page (defaults to open now that the hub fronts the site).
# NEXT_PUBLIC_QAVIER_STORE=live
